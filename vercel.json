{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{public/js/data.js,public/js/dashboard-data.js,db/schema.sql}"
    }
  },
  "rewrites": [{ "source": "/healthz", "destination": "/api/healthz" }]
}

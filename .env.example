ANTHROPIC_API_KEY=
# optional
# CHECK_MODEL=claude-haiku-5-5
# PORT=3000

# Where the SQLite database lives. On a host, point this at a persistent volume, e.g. /data/grounded.db
# DB_FILE=db/grounded.db

# Local development: on first start, fill a new database with a demo school, teacher, class and students
# (logins use the password "demo"). Leave this OFF in production.
# SEED_DEMO=1

# Time zone for the daily quiz and streaks (a new day starts at local midnight here)
# APP_TZ=Asia/Singapore

# Production: marks cookies Secure and trusts the host's proxy for client IPs. Railway and Render set this up
# automatically. On your own server behind HTTPS (Caddy, nginx), set NODE_ENV=production.
# NODE_ENV=production

# Demo logins (student: class code demo / name demo; teacher demo@demo.com; CoffeeBot demo@coffeebot.com; all password "demo")
# are created on every start if missing. Set to 0 to switch off.
# DEMO_ACCOUNTS=0
